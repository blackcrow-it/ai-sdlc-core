{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/orca-sdlc/task.schema.json",
  "title": "Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "title",
    "owner_agent",
    "reviewer_agent",
    "status",
    "dependencies",
    "scope",
    "acceptance_criteria",
    "required_checks",
    "deliverables",
    "max_attempts",
    "human_approval_required"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "owner_agent": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_agent": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "blocked",
        "submitted_for_review",
        "changes_requested",
        "accepted",
        "cancelled"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "forbidden_actions"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "minItems": 1
    },
    "test_seams": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "minItems": 1
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "updates"],
      "description": "Documentation impact and updates owned by this task; legacy contracts may omit this field but cannot pass docs-check until assessed.",
      "properties": {
        "assessment": {"type": "string", "minLength": 10},
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "change", "requirement_ids"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "change": {"type": "string", "minLength": 10, "pattern": "\\S"},
              "requirement_ids": {"type": "array", "uniqueItems": true,
                                  "items": {"type": "string", "minLength": 1, "pattern": "^\\S+$"}}
            }
          }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "time_budget_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "orca_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
