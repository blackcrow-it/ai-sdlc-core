{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/orca-sdlc/artifact.schema.json",
  "title": "Artifact Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "task_id",
    "type",
    "path",
    "status",
    "verified"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "document",
        "source_code",
        "test_result",
        "review",
        "build",
        "release",
        "incident"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted_for_review",
        "accepted",
        "rejected"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "checksum_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
