{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-sdlc-core/project.schema.json",
  "title": "AI SDLC Core project configuration (.ai-sdlc/project.json)",
  "description": "Project-specific data only. It may tighten core policies but never grants permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "core_version", "project", "stack", "architecture", "commands",
               "coding_rules", "scope", "sdlc", "tracker", "orca", "extra_policies"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1"]},
    "core_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "default_branch", "reply_language"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "default_branch": {"type": "string", "minLength": 1},
        "repository_url": {"type": ["string", "null"]},
        "reply_language": {"type": "string", "minLength": 2}
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "package_manager", "runtimes"],
      "properties": {
        "languages": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "frameworks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "package_manager": {"type": ["string", "null"]},
        "runtimes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "summary", "docs", "components"],
      "properties": {
        "style": {"type": "string"},
        "summary": {"type": "string"},
        "docs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "paths"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "build", "lint", "typecheck", "test", "e2e", "security"],
      "properties": {
        "install": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "build": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "lint": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "typecheck": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "test": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "e2e": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "security": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "coding_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "files"],
      "properties": {
        "rules": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "files": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope", "allowed_paths", "protected_paths", "forbidden_actions"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "protected_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "sdlc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled_phases", "enabled_roles", "approvers", "default_max_attempts", "release_environments"],
      "properties": {
        "enabled_phases": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "enabled_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "approvers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["product_owner", "tech_lead", "security_owner", "release_owner"],
          "properties": {
            "product_owner": {"type": ["string", "null"]},
            "tech_lead": {"type": ["string", "null"]},
            "security_owner": {"type": ["string", "null"]},
            "release_owner": {"type": ["string", "null"]}
          }
        },
        "default_max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "release_environments": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "project", "notes"],
      "description": "The single place task contracts live. Conventions: core references/trackers/<provider>.md.",
      "properties": {
        "provider": {"type": "string", "enum": ["local", "github", "gitlab", "jira", "other"]},
        "project": {"type": ["string", "null"]},
        "notes": {"type": "string"},
        "triage_labels": {
          "type": "object",
          "additionalProperties": false,
          "description": "Overrides of the canonical /sdlc-triage label strings; a missing role uses its own name.",
          "properties": {
            "bug": {"type": "string", "minLength": 1},
            "enhancement": {"type": "string", "minLength": 1},
            "needs-triage": {"type": "string", "minLength": 1},
            "needs-info": {"type": "string", "minLength": 1},
            "ready-for-agent": {"type": "string", "minLength": 1},
            "ready-for-human": {"type": "string", "minLength": 1},
            "wontfix": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "orca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "worktree_strategy", "max_parallel_workers"],
      "properties": {
        "agent": {"type": "string", "enum": ["claude", "codex", "antigravity", "opencode"], "description": "Default CLI for roles without an explicit assignment."},
        "role_agents": {
          "type": "object",
          "description": "Optional role-id to Orca CLI mapping. Keys must be enabled SDLC roles; missing roles inherit agent.",
          "additionalProperties": {"type": "string", "enum": ["claude", "codex", "antigravity", "opencode"]}
        },
        "worktree_strategy": {"type": "string", "enum": ["per-task", "current"]},
        "max_parallel_workers": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "extra_policies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
